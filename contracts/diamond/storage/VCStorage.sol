pragma solidity 0.8.28;

/**
 * @title VCStorage
 * @dev Diamond Storage namespace for Verifiable Credential (VC) hash records.
 *      Stores prompt hashes generated by wallets (e.g. MetaMask) and linked
 *      to agents. The full VC content lives in the Agentic Space database;
 *      only the hash is persisted on-chain for verification and integrity.
 *
 *      Padrões: Diamond Storage (EIP-2535), Strategy (pluggable wallet hash)
 */
library VCStorage {
    bytes32 internal constant STORAGE_POSITION =
        keccak256("agentic.space.diamond.vc.storage");

    // -----------------------------------------------------------------------
    // Data structures
    // -----------------------------------------------------------------------

    /// @dev Record of a VC hash linked to an agent prompt.
    struct VCRecord {
        bytes32 vcId;
        bytes32 agentId;
        bytes32 promptHash;
        address signer;
        bytes32 walletType;
        bool isValid;
        uint256 timestamp;
    }

    /// @dev Supported wallet types for hash generation.
    ///      Initially MetaMask; future wallets can be added via the enum
    ///      without breaking existing records.
    enum WalletType {
        None,
        MetaMask,
        WalletConnect,
        Coinbase,
        Custom
    }

    struct VCStorageData {
        mapping(bytes32 => VCRecord) records;
        mapping(bytes32 => bytes32[]) recordsByAgent;
        mapping(bytes32 => mapping(bytes32 => bool)) agentPromptValidated;
        mapping(bytes32 => bool) supportedWallets;
        uint256 recordCount;
    }

    // -----------------------------------------------------------------------
    // Access
    // -----------------------------------------------------------------------

    function vcStorage()
        internal
        pure
        returns (VCStorageData storage s)
    {
        bytes32 position = STORAGE_POSITION;
        assembly {
            s.slot := position
        }
    }
}
