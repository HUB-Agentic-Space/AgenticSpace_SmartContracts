pragma solidity 0.8.28;

import { LibDiamond } from "../diamond/libraries/LibDiamond.sol";
import { DiamondAccessControl } from "../diamond/access/DiamondAccessControl.sol";
import { VCStorage } from "../diamond/storage/VCStorage.sol";
import { AgentStorage } from "../diamond/storage/AgentStorage.sol";
import { AgentHashLib } from "../libs/AgentHashLib.sol";

/**
 * @title AgentValidatorFacet
 * @dev Facet for VC (Verifiable Credential) hash validation using Diamond Storage.
 *      Stores prompt hashes generated by wallets (e.g. MetaMask) on-chain.
 *      The full VC content lives in the Agentic Space database; only the hash
 *      is persisted for integrity verification.
 *
 *      Wallet hash generation is pluggable: the signer address and wallet type
 *      are recorded per VC, allowing future wallet integrations without
 *      contract changes.
 *
 *      Padrões: Diamond Storage (EIP-2535), Strategy (pluggable wallets)
 */
contract AgentValidatorFacet {
    using AgentHashLib for bytes32;

    // -----------------------------------------------------------------------
    // Events
    // -----------------------------------------------------------------------

    event AgentValidated(
        bytes32 indexed agentId,
        bytes32 indexed promptHash,
        bytes32 vcId,
        address indexed signer,
        VCStorage.WalletType walletType
    );
    event ValidationRevoked(bytes32 indexed vcId, address indexed revoker);
    event WalletTypeSupported(VCStorage.WalletType walletType, bool supported);

    // -----------------------------------------------------------------------
    // Errors
    // -----------------------------------------------------------------------

    error AgentNotActive(bytes32 agentId);
    error PromptHashAlreadyValidated(bytes32 agentId, bytes32 promptHash);
    error ValidationNotFound(bytes32 vcId);
    error NotAuthorizedValidator(address caller);
    error WalletTypeNotSupported(VCStorage.WalletType walletType);
    error InvalidSigner();

    // -----------------------------------------------------------------------
    // Init (called via diamondCut delegatecall)
    // -----------------------------------------------------------------------

    function initValidator() external {
        LibDiamond.enforceIsContractOwner();
        VCStorage.VCStorageData storage s = VCStorage.vcStorage();
        s.supportedWallets[bytes32(uint256(VCStorage.WalletType.MetaMask))] = true;
        emit WalletTypeSupported(VCStorage.WalletType.MetaMask, true);
    }

    // -----------------------------------------------------------------------
    // Admin
    // -----------------------------------------------------------------------

    function setWalletTypeSupported(VCStorage.WalletType walletType, bool supported) external {
        DiamondAccessControl.enforceIsContractOwner();
        VCStorage.vcStorage().supportedWallets[bytes32(uint256(walletType))] = supported;
        emit WalletTypeSupported(walletType, supported);
    }

    // -----------------------------------------------------------------------
    // Validation
    // -----------------------------------------------------------------------

    /// @dev Validates an agent by recording a VC hash on-chain.
    /// @param agentId ID of the agent (from AgentRegistryFacet).
    /// @param promptHash Hash of the prompt generated by the wallet.
    /// @param walletType The wallet type that generated the hash (e.g. MetaMask).
    function validateAgent(
        bytes32 agentId,
        bytes32 promptHash,
        VCStorage.WalletType walletType
    ) external returns (bytes32) {
        LibDiamond.enforceNotPaused();
        DiamondAccessControl.enforceRole(DiamondAccessControl.VALIDATOR_ROLE);

        AgentStorage.AgentStorageData storage agentStore = AgentStorage.agentStorage();
        if (!agentStore.activeAgents[agentId]) revert AgentNotActive(agentId);

        VCStorage.VCStorageData storage s = VCStorage.vcStorage();
        if (s.agentPromptValidated[agentId][promptHash]) {
            revert PromptHashAlreadyValidated(agentId, promptHash);
        }
        if (!s.supportedWallets[bytes32(uint256(walletType))]) {
            revert WalletTypeNotSupported(walletType);
        }

        bytes32 vcId = AgentHashLib.computeValidationId(agentId, promptHash, block.timestamp);

        s.records[vcId] = VCStorage.VCRecord({
            vcId: vcId,
            agentId: agentId,
            promptHash: promptHash,
            signer: msg.sender,
            walletType: bytes32(uint256(walletType)),
            isValid: true,
            timestamp: block.timestamp
        });

        s.recordsByAgent[agentId].push(vcId);
        s.agentPromptValidated[agentId][promptHash] = true;
        s.recordCount++;

        emit AgentValidated(agentId, promptHash, vcId, msg.sender, walletType);

        return vcId;
    }

    function revokeValidation(bytes32 vcId) external {
        LibDiamond.enforceNotPaused();
        DiamondAccessControl.enforceRoleOrOwner(DiamondAccessControl.VALIDATOR_ROLE);

        VCStorage.VCStorageData storage s = VCStorage.vcStorage();
        VCStorage.VCRecord storage record = s.records[vcId];
        if (record.timestamp == 0) revert ValidationNotFound(vcId);

        record.isValid = false;
        s.agentPromptValidated[record.agentId][record.promptHash] = false;

        emit ValidationRevoked(vcId, msg.sender);
    }

    // -----------------------------------------------------------------------
    // View
    // -----------------------------------------------------------------------

    function isValidated(bytes32 agentId, bytes32 promptHash) external view returns (bool) {
        VCStorage.VCStorageData storage s = VCStorage.vcStorage();
        return s.agentPromptValidated[agentId][promptHash] && s.recordsByAgent[agentId].length > 0;
    }

    function getValidation(bytes32 vcId) external view returns (VCStorage.VCRecord memory) {
        VCStorage.VCStorageData storage s = VCStorage.vcStorage();
        if (s.records[vcId].timestamp == 0) revert ValidationNotFound(vcId);
        return s.records[vcId];
    }

    function getValidationsByAgent(bytes32 agentId) external view returns (bytes32[] memory) {
        return VCStorage.vcStorage().recordsByAgent[agentId];
    }

    function isAuthorizedValidator(address validator) external view returns (bool) {
        return DiamondAccessControl.hasRole(DiamondAccessControl.VALIDATOR_ROLE, validator);
    }

    function isWalletTypeSupported(VCStorage.WalletType walletType) external view returns (bool) {
        return VCStorage.vcStorage().supportedWallets[bytes32(uint256(walletType))];
    }

    function getVCRecordCount() external view returns (uint256) {
        return VCStorage.vcStorage().recordCount;
    }
}
